# TLS certificate paths
TLS_KEY_PATH=/path/to/your/server.key
TLS_CERT_PATH=/path/to/your/server.crt

# VAPID keys for web push notifications
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=your-public-key-here
VAPID_PRIVATE_KEY=your-private-key-here

# CORS allowed origins (comma-separated)
# For local dev: CORS_ORIGINS=http://localhost:8080
CORS_ORIGINS=https://www.scene-history.org

# MongoDB host (use 'mongo' for docker-compose, 'localhost' for local dev)
MONGO_HOST=localhost

# Session secret — long random string used to sign session cookies
SESSION_SECRET=replace-with-a-long-random-string

# Admin secret — required header value for POST /register (admin-only user creation)
ADMIN_SECRET=replace-with-another-secret
