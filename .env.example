# Scene:History — Environment Variables
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.

# ── MongoDB ──────────────────────────────────────────────
# Connection details for the MongoDB instance
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=oscon-test

# ── SSL / TLS Certificates ───────────────────────────────
# Paths to PEM-encoded certificate files.
# For local development, generate self-signed certs:
#   openssl req -x509 -nodes -days 365 \
#     -newkey rsa:2048 \
#     -keyout server.key -out server.crt \
#     -subj "/CN=localhost"
TLS_KEY_PATH=./server.key
TLS_CERT_PATH=./server.crt

# ── CORS Origins ─────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash).
# Leave empty to allow all origins (not recommended for production).
CORS_ORIGINS=https://www.scene-history.org,https://scene-history.org

# ── Push Notifications (VAPID) ───────────────────────────
# Generate new keys with: npx web-push generate-vapid-keys
# Do NOT reuse the keys shown here in production.
VAPID_PUBLIC_KEY=BJZhZZUqIwbwbGci_pheC3wTwNFcF5btmH7JPCFCF22gk7iJaXmrLznrtBQI_C_HtWZh9BFnwCVKfz7oVgTmaPA
VAPID_PRIVATE_KEY=VCtWHVxRI-MuLAYzcONx-UW38Hwi2qKK2RND_QsgvS8
VAPID_SUBJECT=mailto:brianc@palaver.net

# ── Firebase (client-side) ───────────────────────────────
# apiKey is not secret by design for Firebase, but keep it out of shared repos.
FIREBASE_API_KEY=AIzaSyB9smvGdl026_buW_QnKU-aYt7Y5lYFORE
FIREBASE_AUTH_DOMAIN=scene-history.firebaseapp.com

# ── Node Environment ─────────────────────────────────────
NODE_ENV=development
